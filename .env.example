# ---------------------------------------------------------------------------
# Free Models Hub — all provider credentials are SERVER-SIDE ONLY.
# Never prefix these with NEXT_PUBLIC_ (that would ship them to the browser).
# Copy to .env.local for local development.
# ---------------------------------------------------------------------------
#
# IMPORTANT for hosting dashboards (Vercel, etc.):
# DELETE a variable you do not want rather than leaving it blank. A variable
# that exists with an empty value is NOT the same as an absent one, and blank
# values have caused two production outages here already. The code now
# defends against this (lib/env.ts), but an empty key still reads as
# "provider not configured" and silently disables its routes.

# Groq — primary provider: text, vision, Whisper transcription, TTS.
# https://console.groq.com/keys
# Free tier limits are ORG-level: extra keys do NOT multiply your quota.
GROQ_API_KEY=

# Cloudflare Workers AI — the only free image generation in the stack (FLUX).
# Account ID: dash.cloudflare.com -> Workers & Pages (right sidebar)
# Token: My Profile -> API Tokens -> Workers AI (read+run)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# OpenRouter — last-resort text/vision fallback.
# Only 50 requests/DAY under $10 lifetime credit, so it is not a primary route.
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Upstash Redis — quota counters only. There is no application database.
# https://console.upstash.com  (free: 500K commands/month, 256MB)
# If these are unset the app still runs: counters degrade to per-instance
# memory and the provider's own 429 becomes the backstop.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Salt for the pseudonymous visitor id. Set this to any long random string.
# Raw IPs are never stored -- only sha256(salt + ip), truncated and day-scoped.
VISITOR_HASH_SALT=

# ------------------------------- tuning (optional) -------------------------

# Free runs per visitor per day. With shared keys this is the only thing
# standing between one visitor and the whole day's 1,000-request allowance.
VISITOR_DAILY_LIMIT=15

# Cloudflare's daily neuron pool. Lower it to hold back headroom.
CF_NEURON_DAILY_BUDGET=10000

# Per-step upstream timeout in milliseconds.
STEP_TIMEOUT_MS=45000

# Groq TTS voice. Orpheus accepts: autumn diana hannah austin daniel troy
GROQ_TTS_VOICE=diana

# ------------------------------- public ------------------------------------

# Google Analytics 4 measurement id, e.g. G-XXXXXXXXXX
# OPTIONAL. Without it, custom events still reach Vercel Web Analytics.
# On Vercel set this as type "Config", NOT "Secret": NEXT_PUBLIC_ values are
# compiled into the browser bundle and cannot be secret.
NEXT_PUBLIC_GA_ID=

# Canonical site URL, used for OG tags and OpenRouter attribution headers.
# Production: https://free-models-hub.vercel.app
# Safe to leave BLANK on Vercel -- it falls back to your deployment URL.
# Leave BLANK on Vercel -- it falls back to your deployment URL automatically.
# Set it only for a custom domain. A bare hostname is fine.
NEXT_PUBLIC_SITE_URL=
